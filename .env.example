DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Optional direct (non-pooler) URL for Alembic. If omitted, -pooler is stripped from DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require
STORAGE_PATH=./storage/reports
# Comma-separated frontend origins allowed by the API (local + production).
CORS_ORIGINS=http://localhost:4321,https://maddox-quant.vercel.app
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
AUTO_ANALYZE=false
COLLECT_ENABLED=false
MAX_UPLOAD_MB=50
MARKET_CACHE_TTL_SECONDS=90
MARKET_AKSHARE_TIMEOUT_SECONDS=75

# --- Frontend (set in Vercel project "maddox-quant", or use frontend/.env.production) ---
# NEXT_PUBLIC_API_URL=https://maddox-quant-cdet.vercel.app
# INTERNAL_API_URL=https://maddox-quant-cdet.vercel.app
